{
	"name": "obsidian-from-rednote",
	"version": "0.1.0",
	"description": "把小红书收藏的笔记同步到本地 Obsidian 仓库（Vault），支持 AI 视频转写与图片分析",
	"main": "main.js",
	"scripts": {
		"dev": "esbuild main.ts --watch --bundle --external:obsidian --external:electron --external:@codemirror/ --external:@lezer/ --format=cjs --platform=node --target=es2021 --outfile=main.js --sourcemap",
		"build": "tsc --noEmit && esbuild main.ts --bundle --external:obsidian --external:electron --external:@codemirror/ --external:@lezer/ --format=cjs --platform=node --target=es2021 --outfile=main.js --sourcemap"
	},
	"keywords": [
		"obsidian",
		"rednote",
		"xiaohongshu",
		"sync"
	],
	"author": "YunkaiXiao",
	"license": "MIT",
	"dependencies": {
		"obsidian": "1.13.1",
		"tslib": "2.8.1"
	},
	"devDependencies": {
		"@types/node": "26.5.1",
		"builtin-modules": "5.3.0",
		"esbuild": "0.28.2",
		"typescript": "6.0.3"
	}
}
